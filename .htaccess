RewriteEngine On

# Redirect .php to clean URL (301) — GET/HEAD only so POST/AJAX is not broken
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteCond %{REQUEST_METHOD} =GET [NC]
RewriteRule ^(.+)\.php$ /rastomed/$1 [R=301,L]

# Internally load .php from clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
# Fallback: slug with no matching .php file -> generic page.php router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/rastomed/manager/
RewriteRule ^(.+?)/?$ page.php?slug=$1 [QSA,L]